# Android/Gradle build artifacts
*.jks

# The debug keystore MUST be committed: CI builds sign the debug APK with it
# (see signingConfigs.debugConfig in app/build.gradle.kts). It contains no
# real secrets -- AOSP's standard debug key is public by design.
!debug.keystore

# Gradle wrapper files (gradlew, gradlew.bat, gradle-wrapper.jar) are source
# files and MUST stay committed so GitHub Actions can run ./gradlew directly.

# Local configuration file (sdk path, etc)
local.properties

# IntelliJ IDEA files
.idea/
*.iml
.gradle/